{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skills_used",
    "reviewed_paths",
    "findings",
    "environment_limitations"
  ],
  "properties": {
    "skills_used": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "reviewed_paths": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "line", "title", "reason"],
        "properties": {
          "path": {"type": "string"},
          "line": {"type": "integer", "minimum": 1},
          "title": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "environment_limitations": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
